# Convex
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Publicly reachable application origin used by Convex scheduled callbacks.
SPECTRA_APP_URL=https://your-spectra-deployment.example

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
SPECTRA_MASTER_ENCRYPTION_KEY=
SPECTRA_SECRET_BRIDGE_KEY=
# Authenticates test-lab results before they can unlock an immutable agent
# release. Use an independent random 32+ character value in production.
SPECTRA_AGENT_EVAL_BRIDGE_KEY=
# At least 32 random characters. Configure SPECTRA_COLLAB_BRIDGE_KEY in both
# this server environment and the Convex deployment environment.
SPECTRA_COLLAB_BRIDGE_KEY=
SPECTRA_COLLAB_TOKEN_SECRET=
NEXT_PUBLIC_SPECTRA_COLLAB_URL=ws://localhost:1234
SPECTRA_COLLAB_PORT=1234
# Shared with the Convex worker bridge. The HTTP key authenticates the
# separate worker process back to the app runtime. Use different 32+ character
# random values and never expose either through NEXT_PUBLIC_* variables.
SPECTRA_AI_WORKER_BRIDGE_KEY=
SPECTRA_AI_WORKER_HTTP_KEY=
# Signs server-only ManageBac capability commits. The optional worker HTTP key
# is independent; when omitted it is deterministically derived from the
# connector key. Configure the connector key in both app and Convex runtimes.
SPECTRA_CONNECTOR_BRIDGE_KEY=
SPECTRA_MANAGEBAC_WORKER_HTTP_KEY=
SPECTRA_APP_ORIGIN=http://localhost:3000
CLERK_WEBHOOK_SECRET=

# APIs
OPENROUTER_API_KEY=
TAVILY_API_KEY=
GEMINI_API_KEY=
ARTIFICIAL_ANALYSIS_API_KEY=

# Spectra model routing. GPT-5.6 Luna is the primary OpenRouter route at the
# configured high reasoning profile. Images and PDFs pass natively; the MiMo
# visual prepass remains dormant unless SPECTRA_ATTACHMENT_STRATEGY explicitly
# selects legacy_visual_prepass. Provider recovery can be disabled. DigitalOcean
# remains blocked. SUPER_ADMIN_EMAILS is a comma-separated platform allowlist.
SPECTRA_MODEL_ID=openai/gpt-5.6
SPECTRA_FALLBACK_MODEL_ID=openai/gpt-5.6-luna
SPECTRA_REASONING_PROFILE=xhigh
SPECTRA_ATTACHMENT_STRATEGY=native
SPECTRA_VISION_MODEL_ID=xiaomi/mimo-v2.5
SPECTRA_ALLOW_PROVIDER_FALLBACKS=true
SUPER_ADMIN_EMAILS=
OPENROUTER_APP_NAME=Spectra
OPENROUTER_SITE_URL=http://localhost:3000

# Temporary school-wide ManageBac test credentials (remove before production).
# Admins still connect via /managebac with URL + API key; when the form token
# is left blank, the server may use MANAGEBAC_API_KEY for local verification.
MANAGEBAC_BASE_URL=https://api.managebac.com
MANAGEBAC_API_KEY=
# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# Optional observability
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
