# Convex
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
SPECTRA_MASTER_ENCRYPTION_KEY=
SPECTRA_SECRET_BRIDGE_KEY=
# At least 32 random characters. Configure SPECTRA_COLLAB_BRIDGE_KEY in both
# this server environment and the Convex deployment environment.
SPECTRA_COLLAB_BRIDGE_KEY=
SPECTRA_COLLAB_TOKEN_SECRET=
NEXT_PUBLIC_SPECTRA_COLLAB_URL=ws://localhost:1234
SPECTRA_COLLAB_PORT=1234
# Shared with the Convex worker bridge. The HTTP key authenticates the
# separate worker process back to the app runtime. Use different 32+ character
# random values and never expose either through NEXT_PUBLIC_* variables.
SPECTRA_AI_WORKER_BRIDGE_KEY=
SPECTRA_AI_WORKER_HTTP_KEY=
SPECTRA_APP_ORIGIN=http://localhost:3000
CLERK_WEBHOOK_SECRET=

# APIs
OPENROUTER_API_KEY=
TAVILY_API_KEY=
GEMINI_API_KEY=
ARTIFICIAL_ANALYSIS_API_KEY=

# Spectra rebuild fixed model path
SPECTRA_MODEL_ID=deepseek/deepseek-v4-pro
OPENROUTER_APP_NAME=Spectra
OPENROUTER_SITE_URL=http://localhost:3000

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# Optional observability
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
