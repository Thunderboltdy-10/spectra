# Spectra local-instance template
#
# Copying is handled by `npm run local:add-instance -- --instance N`. The
# harness rewrites the MANAGED values below for each instance. Keep real values
# only in `.env.local` or `.spectra-local/instances/N/env.local`; both are
# gitignored. Never commit credentials.

# ---- MANAGED: local stack identity and URLs ----
# These placeholders are replaced from instance id -> deterministic port block.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_APP_URL=
SPECTRA_APP_URL=
SPECTRA_APP_ORIGIN=
NEXT_PUBLIC_SPECTRA_COLLAB_URL=
SPECTRA_CONVEX_URL=
SPECTRA_LOCAL_INSTANCE=
SPECTRA_WEB_HOST=localhost
SPECTRA_WEB_PORT=
SPECTRA_COLLAB_HOST=127.0.0.1
SPECTRA_COLLAB_PORT=

# Optional non-interactive first-time Convex selection. Set both or neither.
# When blank, `dev:local` opens the normal `convex dev` project prompt once.
SPECTRA_LOCAL_CONVEX_TEAM=
SPECTRA_LOCAL_CONVEX_PROJECT=
# Optional global port mapping overrides. Defaults: base 3000, stride 20.
SPECTRA_LOCAL_PORT_BASE=
SPECTRA_LOCAL_PORT_STRIDE=

# ---- REQUIRED: Clerk ----
# The first two are used by Next.js. CLERK_JWT_ISSUER_DOMAIN is also copied
# into the selected local Convex deployment before application code starts.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
# Optional unless local webhook delivery is being tested.
CLERK_WEBHOOK_SECRET=

# ---- REQUIRED: server and Bridge secrets ----
# Exactly 32 random bytes encoded as base64.
SPECTRA_MASTER_ENCRYPTION_KEY=
# Independent random strings, at least 32 characters each.
SPECTRA_SECRET_BRIDGE_KEY=
SPECTRA_CONNECTOR_BRIDGE_KEY=
SPECTRA_COLLAB_BRIDGE_KEY=
SPECTRA_COLLAB_TOKEN_SECRET=
# Optional; when blank, agent evaluation uses SPECTRA_SECRET_BRIDGE_KEY.
SPECTRA_AGENT_EVAL_BRIDGE_KEY=
SPECTRA_AGENT_MANIFEST_SIGNING_KEY=

# ---- REQUIRED: model provider ----
OPENROUTER_API_KEY=
# Spectra model routing (required). Spectra has no built-in model: change the
# model, provider or reasoning level here and restart. Missing or malformed
# values fail loudly (and fail a production build via scripts/check-deploy-env.mjs).
#   SPECTRA_MODEL_ID           OpenRouter model id used for every Spectra turn
#   SPECTRA_REASONING_PROFILE  none | minimal | low | medium | high | xhigh
#   SPECTRA_MODEL_PROVIDER     OpenRouter provider pinned for primary requests
#   SPECTRA_FALLBACK_MODEL_ID  optional; model for the recovery route (defaults to SPECTRA_MODEL_ID)
#   SPECTRA_FALLBACK_PROVIDERS optional; comma-separated recovery providers (defaults to SPECTRA_MODEL_PROVIDER)
#   SPECTRA_ALLOW_PROVIDER_FALLBACKS  set to false to disable the recovery route
#   SPECTRA_JUDGE_MODEL_ID     optional; independent model that grades agent evaluations
SPECTRA_MODEL_ID=openai/gpt-5.6
SPECTRA_REASONING_PROFILE=xhigh
SPECTRA_MODEL_PROVIDER=OpenAI
SPECTRA_FALLBACK_MODEL_ID=openai/gpt-5.6-luna
SPECTRA_FALLBACK_PROVIDERS=OpenAI
SPECTRA_ALLOW_PROVIDER_FALLBACKS=true
SPECTRA_JUDGE_MODEL_ID=
OPENROUTER_APP_NAME=Spectra Local
OPENROUTER_SITE_URL=

# Optional research / analysis providers.
GEMINI_API_KEY=
ARTIFICIAL_ANALYSIS_API_KEY=

# ---- OPTIONAL: ManageBac local verification ----
# Administrators normally enter the key through /managebac. MANAGEBAC_API_KEY
# is only the local verification fallback when that form value is blank.
MANAGEBAC_BASE_URL=https://api.managebac.com
MANAGEBAC_API_KEY=
SPECTRA_MANAGEBAC_WORKER_HTTP_KEY=

# ---- OPTIONAL: role bootstrap (P9.I4 owns the seed) ----
# Comma-separated platform operator allowlist mirrored into local Convex.
SUPER_ADMIN_EMAILS=
ADMIN_EMAILS=

# ---- OPTIONAL: email ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
INVITE_FROM_EMAIL=
RESEND_API_KEY=

# ---- OPTIONAL: separate AI worker ----
SPECTRA_AI_WORKER_BRIDGE_KEY=
SPECTRA_AI_WORKER_HTTP_KEY=

# ---- OPTIONAL: observability ----
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
