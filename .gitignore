# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-local/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Parameterized local Convex/Next/collaboration instances. Each directory may
# contain credentials, a Convex SQLite database, object storage, and PID state.
/.spectra-local/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/ai-education-workspace-landing-page
opencode*.json

# Browser automation runtime and generated output. Reusable P8 probes live in
# scripts/final-verification/playwright/ and remain tracked.
.playwright-cli/
.playwright/
playwright-report/
test-results/
traces/
recordings/
*.auth-state.json
storage-state-*.json
.shots/

# Film footage and Remotion exports stay local; keep source and capture scripts.
/film/**/*.mp4
/film/**/*.mov
/film/**/*.webm
/film/**/*.mkv
/film/**/*.avi
/film/**/*.m4v
/film/renders/

# Local-only: pre-migration Convex snapshots and scratch working files.
# Never commit user data.
/.backups/
/.tmp-n1/
/bridge/target/
/.tmp-n3-*/
/.tmp-n3-mount/
/.tmp-n3-updater.key*
/.tmp-n4-eval/
/.tmp-n4-appdata/
/.tmp-n4-bridge-isolated/
/.tmp-n4-mount/
/.tmp-n4-target/
/.tmp-n4-sanitize-target/
/.tmp-n5-bridge
/.tmp-n6-bridge
/.tmp-n8-target


# Local review captures and editor launch configs
/docs/review/
/.claude/launch.json
