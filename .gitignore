# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-local/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Parameterized local Convex/Next/collaboration instances. Each directory may
# contain credentials, a Convex SQLite database, object storage, and PID state.
/.spectra-local/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/ai-education-workspace-landing-page
opencode*.json

# Browser automation runtime and generated output. Reusable P8 probes live in
# scripts/final-verification/playwright/ and remain tracked.
.playwright-cli/
.playwright/
playwright-report/
test-results/
traces/
recordings/
*.auth-state.json
storage-state-*.json
.shots/

# Local film projects, recording stages and their supporting tools.
/film/
/src/app/landing/film/
/.claude/skills/remotion*/

# Local-only: pre-migration Convex snapshots and scratch working files.
# Never commit user data.
/.backups/
/.tmp-n1/
/bridge/target/
/.tmp-n3-*/
/.tmp-n3-mount/
/.tmp-n3-updater.key*
/.tmp-n4-eval/
/.tmp-n4-appdata/
/.tmp-n4-bridge-isolated/
/.tmp-n4-mount/
/.tmp-n4-target/
/.tmp-n4-sanitize-target/
/.tmp-n5-bridge
/.tmp-n6-bridge
/.tmp-n8-target


# Local review captures and editor launch configs
/docs/review/
/.claude/launch.json

# Developer tool state and instructions are local to each checkout.
/.claude/
/.codex/
/.factory/
/.opencode/
/.cursor/
/.idea/
/.vscode/
/AGENTS.md
/CLAUDE.md
/CODEX.md
/SKILL.md

# External Office corpus and generated native build metadata.
/fixtures/office/
/bridge/bridge-app/gen/

# Retired deployment and one-off migration tooling.
/workers/
/deploy/collaboration-gateway/railway.toml
/scripts/export-next-generation-migration-baseline.ps1
/scripts/verify-next-generation-migration-baseline.ps1

# Generated review artifacts and agent dispatch state.
/tmp/
/.tmp/
/evidence/
/artifacts/
/reports/
/spectra-redesign-mission-artifacts/
/docs/archive/root-snapshots/
/docs/archive/spectra-definitive/generated/
/docs/spectra-launch-audit/prompts/
/docs/spectra-launch-audit/review-cases/
/docs/spectra-launch-audit/evaluations/*.mjs

# Safe environment templates are public.
!.env.local.example
