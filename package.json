{
  "name": "ai-school",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names web,collab \"npm:dev:web\" \"npm:dev:collab\"",
    "dev:local": "node scripts/local/stack.mjs start",
    "local:build": "node scripts/local/stack.mjs build",
    "local:start": "node scripts/local/stack.mjs start",
    "local:start:prod": "node scripts/local/stack.mjs start --mode production",
    "local:start:all": "node scripts/local/start-all.mjs",
    "local:stop": "node scripts/local/stack.mjs stop",
    "local:rehearse:student-resource": "node scripts/local/student-resource-rehearsal.mjs",
    "local:reset": "node scripts/local/stack.mjs reset",
    "local:add-instance": "node scripts/local/stack.mjs add-instance",
    "local:status": "node scripts/local/stack.mjs status",
    "dev:web": "node --env-file=.env.local scripts/dev-web.mjs",
    "dev:collab": "node scripts/serve-collaboration-gateway.mjs --supervise",
    "start:collab": "node scripts/serve-collaboration-gateway.mjs",
    "collaboration:classroom-load": "node --env-file-if-exists=.env.local scripts/collaboration-classroom-load.mjs",
    "prebuild": "npm run check:secrets && npm run check:capabilities && npm run check:deploy-env",
    "build": "next build",
    "start": "node --env-file=.env.local scripts/start-web.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest",
    "test:run": "npm run test:node && vitest run",
    "test:local-harness": "vitest run scripts/local/stack-config.test.mjs scripts/local/stack-scaffold.test.mjs scripts/local/readiness.test.mjs scripts/reformation-evidence.test.mjs scripts/final-verification/foundation.test.mjs src/lib/__tests__/boot-diagnostics.test.ts src/lib/__tests__/readiness.test.ts src/lib/__tests__/coalesce-inflight.test.ts",
    "test:local-start": "node --test scripts/local/start-all.node.mjs",
    "test:node": "node --test scripts/local/start-all.node.mjs scripts/local/managebac-provider-fixture.node.mjs scripts/s10-security-authorization.node.mjs",
    "test:p8-foundation": "vitest run scripts/final-verification/foundation.test.mjs scripts/reformation-evidence.test.mjs",
    "inventory:spectra": "node scripts/generate-spectra-inventory.mjs --write docs/archive/spectra-definitive/generated/baseline-inventory.json",
    "check:architecture": "node scripts/check-spectra-architecture.mjs",
    "check:copy": "node scripts/check-user-facing-copy.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "check:capabilities": "tsx scripts/check-capability-ir.ts",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "check:deploy-env": "node scripts/check-deploy-env.mjs",
    "smoke:ai": "vitest run --config vitest.smoke.config.ts",
    "test:realtime": "vitest run workers/collaboration",
    "fidelity:docx": "tsx scripts/fidelity-harness/docx.ts",
    "fidelity:office": "tsx scripts/fidelity-harness/office.ts",
    "fidelity:seam": "vitest run src/features/spectra/__tests__/seam-contract.test.ts",
    "build:realtime": "wrangler deploy --dry-run --config workers/collaboration/wrangler.toml",
    "convex:dev": "convex dev",
    "lint:design": "node scripts/report-design-census.mjs",
    "start:collab:raw": "SPECTRA_COLLAB_ALLOW_RAW=1 node scripts/collaboration-gateway.mjs",
    "verify:collab-secrets": "node scripts/verify-collab-secrets.mjs"
  },
